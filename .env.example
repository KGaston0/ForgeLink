# Django settings
# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
# DB_ENGINE=sqlite3 (default) uses a local file named DB_NAME; any other value uses PostgreSQL.
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# PostgreSQL only:
# DB_ENGINE=postgresql
# DB_NAME=forgelink_db
# DB_USER=forgelink_user
# DB_PASSWORD=your-password-here
# DB_HOST=localhost
# DB_PORT=5432

# CORS settings
# Auth uses cookies, so keep CORS_ALLOW_ALL_ORIGINS=False and list the frontend origins
# explicitly (the Vite dev server runs on http://localhost:5173).
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True when serving over HTTPS
JWT_COOKIE_SECURE=False
